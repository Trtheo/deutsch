# Copy this file to .env and fill in your own values. Never commit .env.

# ── Required ──────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/<dbname>
# Long random string for login tokens:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=<long_random_secret>

# ── Website address (used in email links) ─────────────────
APP_URL=http://localhost:3000
PORT=5000

# ── Email (optional; without it, new accounts are verified automatically) ──
# Brevo (free, 300 emails/day). Works on Render's free plan.
#   API key (xkeysib-...) → sends over the web, or
#   SMTP key (xsmtpsib-...) + BREVO_SMTP_LOGIN → Brevo's mail server on port 2525
BREVO_API_KEY=<xkeysib-or-xsmtpsib-key>
BREVO_SMTP_LOGIN=<login>@smtp-brevo.com
# Sender address, verified in Brevo → Senders
EMAIL_FROM=<you@example.com>
# Gmail fallback (blocked on Render's free plan)
EMAIL_USER=<your_gmail_address>
EMAIL_PASS=<gmail_app_password>

# ── Optional ──────────────────────────────────────────────
# Better translations (DeepL free plan); without it the free MyMemory service is used
DEEPL_API_KEY=
# Passphrase for encrypted backups (npm run backup / npm run restore), at least 12 characters
BACKUP_PASSPHRASE=
